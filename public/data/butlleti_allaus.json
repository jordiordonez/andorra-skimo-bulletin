  "espais_protegits": {
    "Sorteny": {
      "descripcio": "Al refugi hi podrem arribar amb esquís i cada vegada hi ha més neu per fer excursions. De moment, però, encara és molt lleugera i pot no aïllar del tot algunes pedres i arbustos. Es recomana mantenir-nos dins del nivell del bosc fins que no millori la visibilitat i puguem identificar el perill d´allaus.",
      "mapa_url": "https://www.meteo.ad/Images/ico-neu/mapes/mapa_sorteny_26122025160033.jpg"
    },
    "Comapedrosa": {
      "descripcio": "Com a tot arreu, haurem de vigilar amb plaques de vent amagades sota la neu nova. Haurem d´evitar els vessants molt inclinats i exposats que estiguin orientats a nord-oest fins a l´est passant pel nord.",
      "mapa_url": "https://www.meteo.ad/Images/ico-neu/mapes/mapa_comapedrosa_26122025160033.jpg"
    },
    "Madriu-Perafita-Claror": {
      "descripcio": "A les canals de Pessons i a prop de les carenes, com poden ser les Montmalús, Serra Seca, Pics Negres d´Envalira o Abelletes poden haver-hi plaques de vent sensibles a sobrecàrregues a les orientacions nord i est. L´accés des de la Plana també està nevat.",
      "mapa_url": null
    }
  },
  "estabilitat_text": "La neu recent d'ahir i les plaques de vent a vegades grans poden fàcilment desencadenar-se de manera natural o accidental. Els indrets perillosos són coberts amb neu recent i difícils de reconèixer. Als vessants orientats a oest i nord les plaques de vent augmentaran de mida addicionalment. Les allaus poden en alguns casos ser desencadenades molt fàcilment i, de manera aïllada, assolir grans dimensions. Es recomana mantenir la distància entre els components. Les excursions de muntanya requereixen una elecció prudent de l'itinerari. Els indrets perillosos són nombrosos i difícils de reconèixer amb mala visibilitat.",
  "qualitat_neu_text": "Des del dilluns ha caigut neu fins a cotes mitges en una zona àmplia. La neu recent es dipositarà a sobre de capes toves en totes les orientacions."
