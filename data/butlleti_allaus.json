  "espais_protegits": {
    "Sorteny": {
      "descripcio": "Les nevades successives que van afectar sobretot el nord d´Andorra van deixar condicions hivernals. Amb l´augment de les temperatures i la radiació solar trobarem una neu tova i amb condicions primaverals a mida que avanci la jornada. Als vessants obacs encara podem trobar neu ventada, lleugerament més dura.",
      "mapa_url": "https://www.meteo.ad/Images/ico-neu/mapes/mapa_sorteny_06042026160008.jpg"
